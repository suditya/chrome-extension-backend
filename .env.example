# Server Configuration
PORT=3000

# MongoDB Configuration
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
DB_NAME=Leetcode-Extension

# Email Configuration (Nodemailer Gmail)
ADMIN_EMAIL=your-email@gmail.com
ADMIN_PASS=your-gmail-app-password

# Optional: Allowed CORS origin (comma-separated or * for all)
CORS_ORIGIN=*

# Public URL used in email review action links
BACKEND_PUBLIC_URL=http://localhost:3000

# Optional: Shared secret token for cron-job.org HTTP trigger
CRON_SECRET=super-secret-cron-key-123
